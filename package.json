{
  "name": "broadsheet",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types && prettier --write worker-configuration.d.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare build && wrangler deploy",
    "dev": "next dev --port 3737",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && npx eslint .",
    "lint:fix": "tsc --noEmit && npx eslint . --fix",
    "migrate": "wrangler d1 migrations apply DB --local",
    "start": "next start",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cloudflare-d1",
    "cloudflare-workers",
    "drizzle-orm",
    "hacker-news",
    "newspaper",
    "nextjs",
    "opennext",
    "rss",
    "typescript"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "description": "Broadsheet: a personalised daily newspaper that turns web feeds into a print-style front page, on Cloudflare Workers and D1.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/broadsheet.git"
  },
  "homepage": "https://github.com/mridang/broadsheet",
  "bugs": "https://github.com/mridang/broadsheet/issues",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.1.0",
    "@tailwindcss/postcss": "^4",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "@jest/reporters": {
      "glob": "^14.0.4"
    },
    "@node-minify/core": {
      "glob": "^14.0.4"
    },
    "@opennextjs/cloudflare": {
      "glob": "^14.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "jest-config": {
      "glob": "^14.0.4"
    },
    "jest-runtime": {
      "glob": "^14.0.4"
    },
    "test-exclude": {
      "glob": "^7.2.3"
    }
  }
}
