{
  "openapi": "3.1.0",
  "info": {
    "title": "broadsheet API",
    "version": "1.0.0",
    "description": "The REST contract of broadsheet, for its own pages. Everything else the app serves (/health, /img, /csp/reports, /auth/*) is outside this contract. Errors are application/problem+json (RFC 9457). Follows the Zalando RESTful API Guidelines with two deliberate deviations: the /api base path, and no hyphens in path segments."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/feeds": {
      "post": {
        "operationId": "followFeed",
        "summary": "Follow a feed",
        "description": "Answers 201 with the new feed, or 200 with the existing one when the person already follows that address. Both carry its Location.",
        "parameters": [
          {
            "$ref": "#/components/parameters/FlowId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The person already follows this feed.",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/Location"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/FlowId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            }
          },
          "201": {
            "description": "The feed is followed.",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/Location"
              },
              "X-Flow-ID": {
                "$ref": "#/components/headers/FlowId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/feeds/{id}": {
      "delete": {
        "operationId": "unfollowFeed",
        "summary": "Stop following a feed",
        "parameters": [
          {
            "$ref": "#/components/parameters/FlowId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,14}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The feed is no longer followed."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/feeds/refreshes": {
      "post": {
        "operationId": "refreshFeeds",
        "summary": "Fetch every followed feed again now",
        "description": "A refresh is not stored, so the result is in the response and there is no Location.",
        "parameters": [
          {
            "$ref": "#/components/parameters/FlowId"
          }
        ],
        "responses": {
          "200": {
            "description": "How the refresh went.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedRefresh"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/sessions": {
      "delete": {
        "operationId": "endAllSessions",
        "summary": "Sign out everywhere",
        "parameters": [
          {
            "$ref": "#/components/parameters/FlowId"
          }
        ],
        "responses": {
          "204": {
            "description": "Every session of the person is ended."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/sessions/self": {
      "delete": {
        "operationId": "endOwnSession",
        "summary": "Sign out",
        "description": "Idempotent; answers 204 even when already signed out.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/FlowId"
          }
        ],
        "responses": {
          "204": {
            "description": "The session cookie is cleared."
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "broadsheet_session",
        "description": "The signed session cookie set by the Google sign-in at /auth/login. The app authenticates callers itself (no gateway sits in front of it)."
      }
    },
    "parameters": {
      "FlowId": {
        "name": "X-Flow-ID",
        "in": "header",
        "required": false,
        "description": "A request id; one is made up when it is absent or not usable.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:~-]{1,128}$"
        }
      }
    },
    "headers": {
      "Location": {
        "description": "The absolute URI of the feed.",
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "FlowId": {
        "description": "The request id, the caller's own or a generated one.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "FeedInput": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "An http or https address."
          }
        }
      },
      "Feed": {
        "type": "object",
        "required": ["id", "url"],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FeedRefresh": {
        "type": "object",
        "required": ["feeds", "refreshed", "failed"],
        "properties": {
          "feeds": {
            "type": "integer"
          },
          "refreshed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "A problem document.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request is not valid; errors names the fields.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Nobody is signed in.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The request came from another site.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such resource.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Over a rate limit, enforced by the platform.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
